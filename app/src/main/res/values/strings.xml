<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Ejemplos-JWT-Android</string>

    <!-- Genéricos -->
    <string name="loading">Cargando…</string>
    <string name="retry">Reintentar</string>
    <string name="value_missing">—</string>

    <!-- Errores de la API -->
    <string name="error_network">No se pudo conectar con el servidor. ¿Está corriendo la API y es correcta la URL base?</string>
