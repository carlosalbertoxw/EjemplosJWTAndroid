    <string name="home_title">Ejemplo JWT</string>
    <string name="home_logout_short">Salir</string>
    <string name="home_tab_session">Sesión</string>
    <string name="home_tab_products">Productos</string>

    <!-- Pestaña Sesión -->
    <string name="session_me_title">Usuario autenticado — GET /api/auth/me</string>
    <string name="session_me_id">id: %1$s</string>
    <string name="session_me_username">usuario: %1$s</string>
    <string name="session_me_role">rol: %1$s</string>
    <string name="session_me_expires">el access token expira: %1$s</string>
    <string name="session_payload_title">Payload del access token</string>
    <string name="session_payload_hint">Decodificado en el dispositivo (Base64Url): cualquiera puede leer los claims de un JWT, pero solo el servidor puede verificar su firma.</string>
