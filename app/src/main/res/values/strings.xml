    <string name="session_logout">Cerrar sesión</string>
    <string name="session_refresh_hint">“Renovar tokens” llama a POST /api/auth/refresh: el refresh token usado queda revocado (rotación) y llega un par nuevo. Ante un 401 esta renovación también ocurre sola y la petición se reintenta.</string>

    <!-- Mensajes -->
    <string name="msg_tokens_refreshed">Tokens renovados: el refresh token anterior quedó revocado</string>
    <string name="msg_product_created">Producto “%1$s” creado con id %2$d</string>

