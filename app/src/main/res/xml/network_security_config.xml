<?xml version="1.0" encoding="utf-8"?>
<!-- Solo los hosts de desarrollo pueden usar HTTP sin TLS; hacia cualquier
     otro host el tráfico en claro queda bloqueado. En producción la API debe
     servirse por HTTPS y esta excepción sobra. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- localhost de la PC visto desde el emulador -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- IP de la PC en la red local, para dispositivo físico -->
        <domain includeSubdomains="false">192.168.1.75</domain>
    </domain-config>
</network-security-config>
