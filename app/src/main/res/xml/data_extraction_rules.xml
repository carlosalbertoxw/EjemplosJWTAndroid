<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no respaldar en la nube ni copiar a otro dispositivo ningún
     dato de la app (incluido el DataStore con los tokens de sesión). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
